# URL base da API Django (sem barra no final). É lida no build: depois de
# mudar, gere o build de novo (na Vercel, "Redeploy").

# Backend local:
VITE_APP_API_URL=http://127.0.0.1:8000/api

# API publicada (PythonAnywhere, com HTTPS). Na Vercel, configure esta
# variável em Settings → Environment Variables:
# VITE_APP_API_URL=https://SEUUSUARIO.pythonanywhere.com/api
